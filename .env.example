UPSTREAM_WEBHOOK_URL=https://agentfaai.ir/api/bots/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-the-same-secret-configured-on-paasta
RELAY_WEBHOOK_PATH=/telegram/webhook
FORWARD_TIMEOUT_SECONDS=7
MAX_BODY_BYTES=1048576
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
WEB_THREADS=4
SETUP_ENDPOINT_ENABLED=false
SETUP_ADMIN_TOKEN=replace-with-a-separate-random-admin-token-at-least-32-characters
TELEGRAM_BOT_TOKEN=replace-with-the-token-issued-by-telegram-botfather
RELAY_PUBLIC_URL=https://your-relay-domain.example
